# Public HTTPS URL of this server, no trailing slash. Not needed on Render (RENDER_EXTERNAL_URL is used).
BASE_URL=https://your-host.example.com

DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to false for a local Postgres without TLS.
DATABASE_SSL=true

# Google OAuth "Web application" client. Redirect URI: ${BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google accounts allowed to authorise the connector itself (comma separated).
OWNER_EMAILS=you@example.com

# Any random string of 32+ characters. Encrypts stored Google refresh tokens.
# Changing or losing it means reconnecting every mailbox.
ENCRYPTION_KEY=

# Optional: addresses forward_to_allowlist may send to without a draft step (comma separated).
# Leave empty to disable that tool.
FORWARD_ALLOWLIST=

# Optional: hosts allowed as OAuth redirect targets for MCP clients. Default: claude.ai,claude.com
# ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com

# Optional: IANA time zone for calendar events created without one. Default: UTC
DEFAULT_TZ=UTC
